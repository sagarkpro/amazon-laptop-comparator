# Copy to .env and adjust as needed. Environment variables are optional.

# Browser
# Open a visible browser window. Use --headless for unattended runs.
HEADLESS=false
# Leave empty to use Playwright's bundled Chromium.
# Set to "chrome" to use an installed Google Chrome channel.
BROWSER_CHANNEL=
SLOW_MO_MS=0
BLOCK_IMAGES=false

# If Amazon shows a CAPTCHA or login page in a headed browser, wait for the
# user to solve it instead of immediately marking the product blocked.
WAIT_FOR_MANUAL_CHALLENGE=true
CHALLENGE_WAIT_MS=600000
CHALLENGE_POLL_MS=2500

# Input / output
LINKS_FILE=data/laptop-links.txt
OUTPUT_DIR=output
MANUFACTURER_SPECS_FILE=data/manufacturer-specs.json
MAX_PRODUCTS=30

# Rate limiting and reliability
CONCURRENCY=1
MIN_DELAY_MS=4000
MAX_DELAY_MS=8000
NAV_TIMEOUT_MS=45000
NAV_RETRIES=2
RETRY_BASE_DELAY_MS=3000
BLOCK_THRESHOLD=2
RESPECT_ROBOTS=true

# Logging / diagnostics
LOG_LEVEL=info
DEBUG=false
